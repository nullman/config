# files to prevent repeats when playing videos
day_tracker="${XDG_CONFIG_HOME}/.atv4-4k-day"
night_tracker="${XDG_CONFIG_HOME}/.atv4-4k-night"

loop() {
    if [[ ! -s "${day_tracker}" ]]; then
         for line in "${day_videos[@]}"; do
              echo "${line}" >> "${day_tracker}"
         done
    fi
    if [[ ! -s "${night_tracker}" ]]; then
         for line in "${night_videos[@]}"; do
              echo "${line}" >> "${night_tracker}"
         done
    fi

    # set the time of day based on the local clock
    # where day is after 7AM and before 7PM
    hour=$(date +%H)
    if [[ "${hour}" -ge 7 ]] || [[ "${hour}" -lt 19 ]]; then
        tracker="${day_tracker}"
    else
        tracker="${night_tracker}"
    fi

    # select at random a video to play from the day or night pools
    count=$(wc -l "${tracker}" | cut -d ' ' -f 1)
    #echo "${tracker} contains ${count} records"
    # two conditions:
    # - 1 line left (one vid) so use the vid and regenerate the list
    # - 2 or more lines left so select a random number between 1 and count
    if [[ ${count} -eq 1 ]]; then
        # last video
        video=$(sed -n "1 p" "${tracker}")

        # exclude the one we just picked
        sed -i "/${video}/d" "${tracker}"
    elif [[ ${count} -ge 2 ]]; then
        # choose random video
        rnd=$((RANDOM % count + 1))
        video=$(sed -n "${rnd} p" "${tracker}")

        # remove the one we just picked
        sed -i "/$video/d" "$tracker"
    fi
    #echo "video: ${video}"
}

# this part taken from Kevin Cox
# https://github.com/kevincox/xscreensaver-videos

IFS=$'\n'
trap : SIGTERM SIGINT SIGHUP
while (true) #!(keystate lshift)
do
    loop
    if [[ -f "${videos}/${video}" ]]; then
        mplayer -nosound -really-quiet -nolirc -nostop-xscreensaver -wid "${XSCREENSAVER_WINDOW}" -fs "${videos}/${video}" &
        pid=$!
        wait $pid
        [ $? -gt 128 ] && { kill $pid; exit 128; }
    fi
done
