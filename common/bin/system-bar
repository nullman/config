#!/usr/bin/env bash
#===============================================================================
# system-bar
#
# Launch system bar and system bar applets in the background.
#
# Author: Kyle W T Sherman <kylewsherman@gmail.com>
#===============================================================================

# delay before launching applets
delay=0

# run executable command if found in the path
_run() {
    command -v "$1" >/dev/null 2>&1 && "$@"
}

# run executable command if found in the path and not already running
_once() {
    if command -v "$1" >/dev/null 2>&1 && ! pidof -q "$1"; then
        "$@"
    fi
}

# delay running a command (SECONDS COMMAND)
_delay() {
    local delay=$1
    shift
    sleep ${delay} && eval "$@"
}

# qubes os
if [ "$(uname -n)" == "dom0" ]; then
    #pkill -u ${USER} xfce4-panel; _once xfce4-panel & disown
    pkill -u ${USER} polybar; sleep 1s && _once polybar -c ${HOME}/.config/polybar/dom0-config.ini >/dev/null 2>&1 & disown
fi

# other os
if [ "$(uname -n)" != "dom0" ]; then
    if [ "${XDG_SESSION_TYPE}" == "wayland" ]; then
        # dank material shell
        pkill -u ${USER} dms; _once dms run --session >/dev/null 2>&1 & disown
    else
        # system bar
        #pkill -u ${USER} polybar; _once polybar -c ${HOME}/.config/polybar/config openbox-bar & disown
        #(pkill -u ${USER} tint2; _once tint2 && sleep 1 && xdo below -t $(xdo id -n root) $(xdo id -N Tint2)) & disown # status bar hidden when fullscreen
        #(_run eww --restart open bar && sleep 1 && xdo below -t $(xdo id -n root) $(xdo id -n eww)) & disown # status bar hidden when fullscreen
        #pkill -u ${USER} xfce4-panel; _once xfce4-panel --disable-wm-check & disown
        pkill -u ${USER} polybar; _once polybar >/dev/null 2>&1 & disown

        # system bar applets
        #(_delay ${delay} pkill -u ${USER} clipit; _once clipit) & disown
        (_delay ${delay} pkill -u ${USER} pa-applet; _once pa-applet) & disown
        (_delay ${delay} pkill -u ${USER} blueman-applet; _once blueman-applet) & disown
        (_delay ${delay} pkill -u ${USER} nm-applet; _once nm-applet) & disown
        #(_delay ${delay} pkill -u ${USER} pamac-tray; _once pamac-tray) & disown
        #if [ -e "/sys/class/power_supply/BAT0" ]; then
        #    (_delay ${delay} pkill -f -u ${USER} xfce4-power-manager; _once xfce4-power-manager) & disown
        #fi
        #(_delay ${delay} pkill -u ${USER} volumeicon; _once volumeicon) & disown
        #(_delay ${delay} pkill -u ${USER} sbxkb; _once sbxkb) & disown
        #(_delay ${delay} pkill -u ${USER} kdeconnect-indicator; _once kdeconnect-indicator) & disown
        (_delay ${delay} pkill -u ${USER} localsend; _once localsend --hidden) & disown
    fi
fi

#===============================================================================
# End of File
#===============================================================================
